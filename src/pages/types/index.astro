---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PendingNotice from '../../components/PendingNotice.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site-config';
import { SITES } from '../../lib/sites';
import { breadcrumbJsonLd } from '../../lib/seo';

/* Type entries are not published until product records exist. */
const products = await getCollection('products');

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Types', path: '/types/' },
];

/* Classification axes only — no type records are asserted here. */
const axes = [
  {
    title: 'Raw-material base',
    body: 'The carbonised feedstock behind the product (for example shell, wood or other biomass sources). Recorded as raw_material and charcoal_source on each product record.',
  },
  {
    title: 'Carbonised form',
    body: 'Whether the product is a briquette, an extruded/cut shape, or a granular/irregular grade. Recorded as shape, together with the size class.',
  },
  {
    title: 'Product family',
    body: 'The commercial family a product is sold under, and the application it targets. Recorded as product_type and application.',
  },
  {
    title: 'Grade / positioning',
    body: 'Whether the product is positioned for premium water-pipe use, commercial grilling or another combustion use, and whether it is a private-label line.',
  },
];

const jsonLd = [
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, Astro.site).href }))),
];
---

<BaseLayout
  site={site}
  title="Product Types"
  description="How charcoal products are classified in the database: raw-material base, carbonised form, product family and grade. Type entries are pending supplier verification."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: c.path }))}
>
  <div class="container">
    <div class="page-title">
      <h1>Product types</h1>
      <p class="lede">
        The type taxonomy exists to group records, not to create pages. No type
        page is generated from a keyword — a type becomes a browsable entry only
        once verified products exist under it.
      </p>
    </div>

    <PendingNotice
      title="Data pending — supplier verification in progress"
      body="No product types are published yet. Type entries are derived from verified product records: with no verified records, there is nothing to group. The classification axes below describe the schema that will drive this index."
    />

    <section class="section">
      <div class="section-head">
        <h2>Classification axes</h2>
        <p>
          Each product record is typed along these axes. A type entry is created
          from the records, never in advance of them.
        </p>
      </div>
      <div class="grid grid-2">
        {
          axes.map((a) => (
            <div class="card">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Types</h2>
        <p>Type entries appear here once records exist under them.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Type</th><th>Raw material</th><th>Form</th><th>Published records</th></tr>
          </thead>
          <tbody>
            <tr>
              <td class="null" colspan="4">
                No type entries yet — data pending, supplier verification in
                progress. {products.length} verified product records currently
                support the taxonomy.
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="meta-line">
        See <a href="/products/">product records</a>,
        <a href="/applications/">applications</a> and
        <a href="/sizes/">size classes</a> for the other filtering axes.
      </p>
    </section>
  </div>
</BaseLayout>
