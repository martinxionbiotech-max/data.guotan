---
/* ------------------------------------------------------------------ */
/* /products/<slug>/ — product record detail.                          */
/*                                                                     */
/* Each entry in src/content/products/ generates its own page.         */
/* No entry = no page (no fabricated records).                         */
/* ------------------------------------------------------------------ */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site-config';
import { SITES } from '../../lib/sites';
import { breadcrumbJsonLd, articleJsonLd, productJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('products');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

/* A null value is never rendered as a bare dash: it either has a stated
   pending reason or it cannot apply to this record's form. */
const pendingByField = new Map(d.pending_fields.map((p) => [p.field, p]));
const naFields = new Set(d.not_applicable.map((n) => n.field));
const show = (value: string | null, field: string) =>
  value ?? (pendingByField.has(field) ? 'data pending' : naFields.has(field) ? 'not applicable' : 'Not declared');

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
  { name: d.product_name, path: `/products/${entry.id.replace(/\.md$/, '')}/` },
];

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  productJsonLd({
    id: canonical,
    name: d.product_name,
    description: `${d.product_name} — ${d.product_type ?? 'charcoal product'} for ${d.application ?? 'application'}. ${d.verification_status ?? 'Verification pending'} record.`,
    brand: d.product_name.split(' ')[0] ?? undefined,
    category: d.product_type ?? undefined,
    properties: [
      { name: 'Raw material', value: d.raw_material ?? 'Not declared' },
      { name: 'Size', value: d.size ?? 'Not declared' },
      { name: 'Ash content', value: d.ash_content ?? 'Not declared' },
      { name: 'Moisture', value: d.moisture ?? 'Not declared' },
      { name: 'Calorific value', value: d.calorific_value ?? 'Not declared' },
      { name: 'Burning time', value: d.burning_time ?? 'Not declared' },
      { name: 'Ignition time', value: d.ignition_time ?? 'Not declared' },
      { name: 'Packaging', value: d.packaging ?? 'Not declared' },
      { name: 'Verification status', value: d.verification_status ?? 'Not set' },
    ],
  }),
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, Astro.site).href }))),
];

const facts: Array<[string, string]> = [
  ['Product', d.product_name],
  ['Raw material', show(d.raw_material, 'raw_material')],
  ['Application', show(d.application, 'application')],
  ['Size', show(d.size, 'size')],
  ['Ash', show(d.ash_content, 'ash_content')],
  ['Moisture', show(d.moisture, 'moisture')],
  ['Fixed carbon', show(d.fixed_carbon, 'fixed_carbon')],
  ['Calorific value', show(d.calorific_value, 'calorific_value')],
  ['Burning time', show(d.burning_time, 'burning_time')],
  ['MOQ', show(d.minimum_order_quantity, 'minimum_order_quantity')],
  ['OEM', show(d.private_label, 'private_label')],
  ['Manufacturer', d.manufacturer_id ?? 'Not yet verified'],
  ['Verification', d.verification_status ?? 'Not set'],
];
---

<BaseLayout
  site={site}
  title={d.product_name}
  description={d.meta_description}
  canonical={canonical}
  jsonLd={jsonLd}
  ogType="article"
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: c.path }))}
>
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">Product record</p>
      <h1>{d.product_name}</h1>
    </div>

    {
      d.product_id?.startsWith('p-firemax') && (
        <div class="page-title-media">
          <img
            src={`/images/products/firemax-${d.product_id.replace('p-firemax-', '').replace('-bamboo-cube', '').replace('-instant-light-tablet', '').replace('-silver-bar', '')}.${d.product_id.includes('rb33') ? 'jpeg' : 'png'}`}
            alt={`${d.product_name} — supplier product photo`}
            width="800"
            height="800"
            loading="lazy"
          />
        </div>
      )
    }

    <div class="quick-facts">
      {facts.map(([label, value]) => (
        <div class="qf">
          <span class="qf-label">{label}</span>
          <span class="qf-value">{value}</span>
        </div>
      ))}
    </div>

    <div class="callout">
      <span class="callout-title">Verification: {d.verification_status ?? 'not set'}</span>
      <span>
        Values carry a verification status and a data source. Nothing on this
        page is presented as CHARCOAL HUB test data unless it is labelled as
        such. Source: {d.data_source ?? 'not recorded'}. Last verified:{' '}
        {d.last_verified ?? 'never'}.
      </span>
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      d.pending_fields.length > 0 && (
        <section class="section" id="field-status">
          <div class="section-head">
            <h2>Field status</h2>
            <p>
              {d.pending_fields.length} field{d.pending_fields.length === 1 ? '' : 's'} on this record
              {d.pending_fields.length === 1 ? ' is' : ' are'} still empty. Each one carries the
              reason it cannot be filled yet, so an empty field is never read as a zero, a
              default or a guess.
            </p>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Field</th><th>Why it is empty</th><th>Owed by</th></tr>
              </thead>
              <tbody>
                {d.pending_fields.map((p) => (
                  <tr>
                    <td class="mono">{p.field}</td>
                    <td>{p.reason}</td>
                    <td>{p.owner ?? 'Supplier / sourcing team'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {d.not_applicable.length > 0 && (
            <p class="meta-line">
              Not applicable to this form:{' '}
              {d.not_applicable.map((n, i) => (
                <span>{i > 0 ? '; ' : ''}<span class="mono">{n.field}</span> ({n.reason})</span>
              ))}
            </p>
          )}
        </section>
      )
    }

    <p class="meta-line">
      <a href="/products/">All product records</a> ·{' '}
      <a href={`${SITES.main}/request-sample/`}>Request a sample</a> ·{' '}
      <a href={`${SITES.main}/request-quote/`}>Request a quote</a>
    </p>
  </div>
</BaseLayout>
