---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site-config';
import { SITES, BRAND } from '../../lib/sites';
import { breadcrumbJsonLd, articleJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const entries = await getCollection('specifications');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Specifications', path: '/specifications/' },
  { name: d.title, path: `/specifications/${d.slug}/` },
];

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  articleJsonLd({
    id: canonical,
    headline: d.title,
    description: d.description,
    datePublished: d.last_updated,
    dateModified: d.last_updated,
  }),
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, Astro.site).href }))),
];

const sections = [
  { heading: 'What It Measures', body: d.what_it_measures },
  { heading: 'Why It Matters', body: d.why_it_matters },
  { heading: 'Typical Measurement Method', body: d.typical_method },
  { heading: 'Buyer Relevance', body: d.buyer_relevance },
  { heading: 'Limitations', body: d.limitations },
];
---

<BaseLayout
  site={site}
  title={d.title}
  description={d.description}
  canonical={canonical}
  jsonLd={jsonLd}
  ogType="article"
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: c.path }))}
>
  <div class="container">
    <div class="page-title">
      <p class="eyebrow">Specification methodology</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
    </div>

    <div class="quick-facts">
      <div class="qf">
        <span class="qf-label">Metric</span>
        <span class="qf-value">{d.metric}</span>
      </div>
      <div class="qf">
        <span class="qf-label">Last updated</span>
        <span class="qf-value mono">{d.last_updated}</span>
      </div>
      <div class="qf">
        <span class="qf-label">Data source</span>
        <span class="qf-value">{d.data_source}</span>
      </div>
    </div>

    <div class="callout">
      <span class="callout-title">Methodology only — no supplier test data.</span>
      <p>
        This page describes a public standard measurement in general terms. It
        contains no {BRAND} test result and no supplier-specific value. Figures for
        a real batch come from a laboratory report on that batch.
      </p>
    </div>

    <article class="prose">
      {
        sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p>{s.body}</p>
          </>
        ))
      }

      <h2>Data Source</h2>
      <p>{d.data_source}</p>
      <ul>
        <li>Method family cited in general terms only; no laboratory result is published here.</li>
        <li>Last updated <span class="mono">{d.last_updated}</span>.</li>
        <li>
          Measurement uncertainty applies to any real figure derived by these
          methods and should be reported with it.
        </li>
      </ul>

      <Content />

      <h2>Where to go next</h2>
      <ul>
        <li><a href="/specifications/">All specification methodology pages</a></li>
        <li><a href="/products/">Product database</a> — records pending verification</li>
        <li><a href="/compare/">Compare records</a></li>
        <li>
          <a href={`${SITES.testing}/`} target="_blank" rel="noopener">Testing sub-site</a>
          {' '}— laboratory-side method detail
        </li>
        <li>
          <a href={`${SITES.main}/request-quote/`} target="_blank" rel="noopener">Request a quote</a>
          {' '}— batch-specific datasheet
        </li>
      </ul>
    </article>
  </div>
</BaseLayout>
